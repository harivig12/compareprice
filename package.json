{
  "name": "jhola",
  "version": "1.3.0",
  "description": "Jhola: the cheapest grocery basket across the top quick-commerce sites. A warm headless-Chrome engine, price history, schedules, a web UI, a CLI and an MCP server. Self-hosted, no logins.",
  "type": "module",
  "license": "MIT",
  "author": "Soubhik Halder",
  "homepage": "https://harivig12.github.io/jhola/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harivig12/jhola.git"
  },
  "bugs": {
    "url": "https://github.com/harivig12/jhola/issues"
  },
  "bin": {
    "jhola": "src/cli.js",
    "basket": "src/cli.js"
  },
  "files": [
    "src/**/*",
    "scripts/build-adapters.js",
    "basket.txt",
    "README.md",
    "LICENSE",
    "Dockerfile",
    "docker-compose.yml",
    "docs/**/*",
    "scripts/build-site.js",
    "CHANGELOG.md",
    "assets/brand/**/*",
    "scripts/build-icons.js"
  ],
  "scripts": {
    "serve": "node src/cli.js serve",
    "run-now": "node src/cli.js run-now",
    "compare": "node src/cli.js basket.txt",
    "ui": "node src/cli.js basket.txt --ui",
    "web": "node src/cli.js basket.txt --web",
    "mcp": "node src/mcp-server.js",
    "test": "node --test test/*.test.js",
    "test:live": "LIVE=1 node --test test/engine-sites.test.js test/engine-chrome.test.js",
    "setup": "node src/cli.js setup",
    "doctor": "node src/cli.js doctor",
    "build:adapters": "node scripts/build-adapters.js",
    "probe": "node scripts/probe.js",
    "build:site": "node scripts/build-site.js",
    "build:icons": "node scripts/build-icons.js"
  },
  "keywords": [
    "jhola",
    "grocery",
    "price-comparison",
    "price-tracker",
    "quick-commerce",
    "india",
    "self-hosted",
    "headless-chrome",
    "docker",
    "sqlite",
    "mcp",
    "cli"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
